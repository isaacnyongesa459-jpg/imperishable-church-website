
# ==============================================================================
# M-PESA DARAJA API CONFIGURATION
# ==============================================================================
# WARNING: Keep this file secure. Never commit it to GitHub or source control.

# Daraja Application Credentials
MPESA_CONSUMER_KEY="YOUR_CONSUMER_KEY_HERE"
MPESA_CONSUMER_SECRET="YOUR_CONSUMER_SECRET_HERE"

# Shortcode Configuration
# Use your 6-digit Paybill or Till number. For Sandbox Express, default is 174379.
MPESA_SHORTCODE="174379"
MPESA_PASSKEY="YOUR_PASSKEY_HERE"

# API Environment Setup
# Sandbox:    https://sandbox.safaricom.co.ke
# Production: https://api.safaricom.co.ke
MPESA_BASE_URL="https://sandbox.safaricom.co.ke"

# Webhook Callback Configuration
# MUST be a public HTTPS URL. Replace with your ngrok URL during local testing.
MPESA_CALLBACK_URL="https://your-domain.com"

# STK Push Metadata
MPESA_TRANSACTION_TYPE="CustomerPayBillOnline" # Use "CustomerBuyGoodsOnline" for Till Numbers
MPESA_ACCOUNT_REFERENCE="ChurchDonation"       # Max 12 characters, no spaces/special chars
MPESA_TRANSACTION_DESC="Church Contribution"   # Max 13 characters

# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
NODE_ENV="development"
PORT=3000
