
# ==============================================================================
# M-PESA DARAJA API CONFIGURATION
# ==============================================================================
# SECURITY WARNING:
# Keep this file secure. Never commit it to GitHub or any other source control.
# Store your actual credentials in your local .env file.

# ------------------------------------------------------------------------------
# 1. DARAJA APPLICATION CREDENTIALS
# ------------------------------------------------------------------------------
MPESA_CONSUMER_KEY="YOUR_CONSUMER_KEY_HERE"
MPESA_CONSUMER_SECRET="YOUR_CONSUMER_SECRET_HERE"

# ------------------------------------------------------------------------------
# 2. SHORTCODE AND PASSKEY CONFIGURATION
# ------------------------------------------------------------------------------
# Sandbox Express default shortcode: 174379
# Replace this with your assigned Paybill or Till number when necessary.

MPESA_SHORTCODE="174379"
MPESA_PASSKEY="YOUR_PASSKEY_HERE"

# ------------------------------------------------------------------------------
# 3. API ENVIRONMENT CONFIGURATION
# ------------------------------------------------------------------------------
# Sandbox:    https://sandbox.safaricom.co.ke
# Production: https://api.safaricom.co.ke

MPESA_BASE_URL="https://sandbox.safaricom.co.ke"

# ------------------------------------------------------------------------------
# 4. CALLBACK / WEBHOOK CONFIGURATION
# ------------------------------------------------------------------------------
# Use a publicly accessible HTTPS URL.
# For local development, replace this with your active ngrok HTTPS URL.

MPESA_CALLBACK_URL="https://your-domain.com"

# ------------------------------------------------------------------------------
# 5. STK PUSH TRANSACTION CONFIGURATION
# ------------------------------------------------------------------------------
# CustomerPayBillOnline: For Paybill transactions
# CustomerBuyGoodsOnline: For Till transactions

MPESA_TRANSACTION_TYPE="CustomerPayBillOnline"

# Account reference (maximum 12 characters)
MPESA_ACCOUNT_REFERENCE="ChurchDonation"

# Transaction description (maximum 13 characters)
MPESA_TRANSACTION_DESC="Church Contribution"

# ------------------------------------------------------------------------------
# 6. NODE.JS SERVER CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV="development"
PORT=3000
