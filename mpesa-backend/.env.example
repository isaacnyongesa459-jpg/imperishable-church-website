
# Daraja environment: sandbox for testing, production for live payments
MPESA_ENV=sandbox

# Safaricom Daraja credentials
MPESA_SHORTCODE=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=

# Render backend public URL, without a trailing slash
MPESA_CALLBACK_BASE_URL=

# PostgreSQL connection URL from Render
DATABASE_URL=

# Optional donation account reference
MPESA_ACCOUNT_REFERENCE=ChurchDon
