
# Daraja environment: sandbox for testing, production for live payments
MPESA_ENV=sandbox

# Safaricom Daraja credentials
MPESA_SHORTCODE=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=

# Render backend public URL, without a trailing slash
MPESA_CALLBACK_BASE_URL=

# PostgreSQL connection URL from Render
DATABASE_URL=

# Optional donation account reference
MPESA_ACCOUNT_REFERENCE=ChurchDon

# Paystack: keep the secret key private in backend/Render environment settings.
PAYSTACK_SECRET_KEY=
# Optional deployed donation return URL.
PAYSTACK_CALLBACK_URL=https://isaacnyongesa459-jpg.github.io/imperishable-church-website/donate.html

# Required administrator credentials (set only in Render environment settings)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Generate a random secret of at least 32 characters; never commit the value
ADMIN_SESSION_SECRET=
