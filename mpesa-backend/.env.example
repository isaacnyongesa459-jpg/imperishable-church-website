
# Daraja environment: sandbox for testing, production for live payments
MPESA_ENV=sandbox

# Safaricom Daraja credentials
MPESA_SHORTCODE=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=

# Render backend public URL, without a trailing slash
MPESA_CALLBACK_BASE_URL=

# PostgreSQL connection URL from Render
DATABASE_URL=

# Optional donation account reference
MPESA_ACCOUNT_REFERENCE=ChurchDon

# PayPal: use sandbox credentials for testing; set PAYPAL_ENV=live for production payments.
PAYPAL_ENV=live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Bootstrap owner account (set only in Render environment settings).
# On first boot, its password is stored in PostgreSQL as a salted scrypt hash.
# Changing ADMIN_PASSWORD later does not reset an existing database account.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Generate a random secret of at least 32 characters; never commit the value
ADMIN_SESSION_SECRET=
